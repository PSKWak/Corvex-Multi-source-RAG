# Copy to .env and fill in only what you use. The fully-offline path
# (backend=local, embedder=hashing, llm=mock) needs NONE of these.
# .env is gitignored; this template is not — keep real secrets out of it.

# --- Generation / self-check / RAGAS LLM (pick the one(s) you set llm: to) ---
GROQ_API_KEY=            # https://console.groq.com  (free tier)
GEMINI_API_KEY=          # https://aistudio.google.com/app/apikey  (free tier)
ANTHROPIC_API_KEY=       # optional
OPENAI_API_KEY=          # optional

# --- Optional reranker comparison ---
COHERE_API_KEY=          # https://dashboard.cohere.com  (trial: 1000 calls/mo)

# --- Elasticsearch (only if index.backend: elastic) ---
ELASTIC_API_KEY=         # Kibana > Management > API keys > Create API key > "Encoded" value
ELASTIC_HOST=            # the Elasticsearch endpoint URL (….es.<region>.<cloud>…), not the .kb. Kibana URL
# self-hosted alternative to the API key:
ELASTIC_USER=elastic
ELASTIC_PASSWORD=
